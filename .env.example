[TEMPLATE]
# =============================================================================
# MIND MATRIX — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit your .env file with real secrets.
# =============================================================================

# --- Frontend-safe (exposed to the browser) ---
# These are safe to expose — they use the Supabase anon/publishable key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-side only (NEVER expose to the browser) ---
# These are used ONLY in Supabase Edge Functions.
# NEVER create VITE_ prefixed versions of these.
SUPABASE_SECRET_KEY=

# =============================================================================
# AI Provider: OpenRouter (Primary text generation)
# Get your free API key at: https://openrouter.ai/keys
# Free models available — no payment required for basic usage.
# =============================================================================
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# =============================================================================
# AI Provider: Cloudflare Workers AI (Secondary text + image generation)
# Get your credentials at: https://dash.cloudflare.com/?to=/:account/ai
# Free tier: 10,000 neurons/day.
# =============================================================================
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-base-en-v1.5
CLOUDFLARE_IMAGE_MODEL=@cf/stabilityai/stable-diffusion-xl-base-1.0

# =============================================================================
# SECURITY RULES:
# 1. NEVER create: VITE_OPENROUTER_API_KEY, VITE_CLOUDFLARE_API_TOKEN
# 2. NEVER hardcode secrets into source code
# 3. NEVER place real secret values in generated source files
# 4. All AI provider calls must go through Edge Functions, not the browser
# =============================================================================
